{
  "title": "Worx Vision Cloud PLUS",
  "config": {
    "step": {
      "user": {
        "title": "Worx Vision Cloud PLUS",
        "description": "Use the same login as in the Worx Landroid app.",
        "data": {
          "email": "Email",
          "password": "Password",
          "cloud": "Cloud",
          "verify_ssl": "Verify SSL",
          "expose_raw_entities": "Expose all raw payload fields as entities"
        }
      },
      "reauth_confirm": {
        "title": "Sign in again",
        "description": "Worx rejected the saved login for {email}. Enter the current Worx Landroid app password.",
        "data": {
          "password": "Password"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not connect to Worx Cloud.",
      "invalid_auth": "Invalid login or password.",
      "rate_limited": "Worx Cloud rate limit. Try again later."
    },
    "abort": {
      "already_configured": "This account is already configured.",
      "reauth_successful": "The login was updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "description": "Raw entities are meant for debugging. Turning the option off removes them.",
        "data": {
          "expose_raw_entities": "Expose all raw payload fields as entities"
        }
      }
    }
  },
  "services": {
    "start_one_time_mowing": {
      "name": "Start one-time mowing",
      "description": "Starts one-time mowing. Runtime is the work duration for boundary-wire mowers and a technical limit for Vision/RTK mowers. Runtime 0 with edge cutting starts an edge-only pass.",
      "fields": {
        "entity_id": {
          "name": "Mower",
          "description": "Worx Vision Cloud PLUS mower entity."
        },
        "runtime": {
          "name": "Mowing time",
          "description": "One-time mowing time in minutes. Use 0 with edge cutting to start only the edges."
        },
        "edge_cut": {
          "name": "Edge cutting",
          "description": "Includes edge cutting in the one-time mowing command."
        },
        "zones": {
          "name": "Zones (experimental)",
          "description": "Optional zone IDs. Boundary-wire mowers support one zone. Vision/RTK firmware may ignore this selection."
        }
      }
    }
  },
